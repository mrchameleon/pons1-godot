[gd_scene load_steps=2 format=3 uid="uid://swbacfmle6gi"]

[sub_resource type="GDScript" id="GDScript_06r0y"]
script/source = "extends Control

signal play
@onready var button: Button = $Button


func _on_button_pressed() -> void:
	button.visible = false
	emit_signal(\"play\")
"

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_06r0y")

[node name="Button" type="Button" parent="."]
layout_mode = 0
offset_left = 422.0
offset_top = 243.0
offset_right = 572.0
offset_bottom = 352.0
theme_override_font_sizes/font_size = 99
text = "Play"

[connection signal="pressed" from="Button" to="." method="_on_button_pressed"]
